{
  "kind": "collectionType",
  "collectionName": "product_article_descriptions",
  "info": {
    "singularName": "product-article-description",
    "pluralName": "product-article-descriptions",
    "displayName": "productArticleDescription",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "description": {
      "type": "richtext"
    },
    "technicalDetail": {
      "type": "richtext"
    },
    "whashing": {
      "type": "boolean"
    },
    "composition": {
      "type": "string"
    },
    "maxWashingTemp": {
      "type": "decimal"
    },
    "reduction": {
      "type": "richtext"
    },
    "weight": {
      "type": "decimal"
    },
    "size": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    },
    "product_article": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product-article-card.product-article-card",
      "inversedBy": "product_article_description"
    },
    "productImages": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": true
    },
    "product_colors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product-color.product-color",
      "inversedBy": "product_article_descriptions"
    },
    "product_filters": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product-filter.product-filter",
      "inversedBy": "product_article_descriptions"
    }
  }
}
