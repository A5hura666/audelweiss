{
  "kind": "collectionType",
  "collectionName": "product_comments",
  "info": {
    "singularName": "product-comment",
    "pluralName": "product-comments",
    "displayName": "ProductComment",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "product_article_description": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product-article-description.product-article-description"
    },
    "comment": {
      "type": "text"
    },
    "commentImage": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "productCommentDate": {
      "type": "date"
    },
    "commentNote": {
      "type": "integer",
      "required": true,
      "max": 5,
      "min": 0
    },
    "authorName": {
      "type": "string"
    },
    "authorEmail": {
      "type": "string"
    }
  }
}
